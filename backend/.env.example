# 数据库配置
DATABASE_URL=mysql://root:root@127.0.0.1:3306/stockpy
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/stockpy

# API密钥（如需使用在线API）
TENCENT_API_KEY=your_tencent_key
EASTMONEY_API_KEY=your_eastmoney_key
SINA_API_KEY=your_sina_key

# 定时任务配置
UPDATE_SCHEDULE_TIME=16:00
UPDATE_TIMEZONE=Asia/Shanghai

# 应用配置
DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 数据源配置
DATA_SOURCE_TYPE=local  # local, api, web_scrape
LOCAL_DATA_PATH=D:\通达信  # 本地同花顺/通达信数据路径
ENABLE_TENCENT_API=False
ENABLE_EASTMONEY_API=False

# WebSocket配置
WS_ENABLED=True
WS_HEARTBEAT_INTERVAL=30  # 秒

# 回测配置
BACKTEST_BATCH_SIZE=100
BACKTEST_SLIPPAGE=0.001  # 滑点 0.1%
