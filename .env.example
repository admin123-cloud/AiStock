# AiStock 环境变量配置示例
# 复制此文件为 .env 并填入实际的配置信息

# 应用配置
APP_NAME=AiStock
APP_VERSION=1.0.0
DEBUG=true
TIMEZONE=Asia/Shanghai

# External split-layer paths
AISTOCK_DATA_ROOT=F:\Stock\AiStockData\data
AISTOCK_REPORTS_ROOT=F:\Stock\AiStockResearchArchive\reports
AISTOCK_ARTIFACTS_ROOT=F:\Stock\AiStockData\artifacts
AISTOCK_LOGS_ROOT=F:\Stock\AiStockData\logs

# 数据库配置
DATABASE_TYPE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_NAME=stock
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# 日志配置
LOG_LEVEL=DEBUG
LOG_ROTATION=100 MB
LOG_RETENTION=7 days
LOG_COMPRESSION=zip

# 缓存配置
CACHE_ENABLED=true
CACHE_TYPE=memory
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Redis配置（如果使用Redis缓存）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# API配置
API_HOST=0.0.0.0
API_PORT=8000

# Tushare配置
TUSHARE_TOKEN=your_tushare_token_here

# 通达信配置
TDX_HOSTS=119.147.212.81:7709,218.75.126.9:7709,115.238.56.198:7709
TDX_TIMEOUT=10

# 东方财富配置
EASTMONEY_API_URL=https://push2.eastmoney.com

# 腾讯配置
TENCENT_API_URL=https://qt.gtimg.cn

# 模型配置
MODEL_SAVE_PATH=models/
MODEL_BATCH_SIZE=32
MODEL_LEARNING_RATE=0.001
MODEL_EPOCHS=100

# 回测配置
BACKTEST_INITIAL_CAPITAL=1000000
BACKTEST_COMMISSION_RATE=0.0003
BACKTEST_SLIPPAGE_RATE=0.0001

# 风控配置
RISK_MAX_POSITION_RATIO=0.3
RISK_MAX_TOTAL_POSITION=0.8
RISK_MAX_DRAWDOWN=0.15
RISK_STOP_LOSS_RATIO=0.05

# 代理配置（可选）
PROXY_ENABLED=false
PROXY_HTTP=
PROXY_HTTPS=

# 邮件通知配置（可选）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=recipient@example.com

# 钉钉通知配置（可选）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token
# DINGTALK_SECRET=your_secret

# 微信通知配置（可选）
# WECHAT_CORPID=your_corpid
# WECHAT_AGENTID=your_agentid
# WECHAT_SECRET=your_secret
# WECHAT_TOUSER=your_userid
