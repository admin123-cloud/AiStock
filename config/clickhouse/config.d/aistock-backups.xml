<clickhouse>
  <storage_configuration>
    <disks>
      <backups><type>local</type><path>/backups/</path></backups>
    </disks>
  </storage_configuration>
  <backups>
    <allowed_disk>backups</allowed_disk>
    <allowed_path>/backups/</allowed_path>
    <allow_concurrent_backups>false</allow_concurrent_backups>
    <allow_concurrent_restores>false</allow_concurrent_restores>
  </backups>
  <backup_threads>1</backup_threads>
  <max_backups_io_thread_pool_size>2</max_backups_io_thread_pool_size>
  <max_backup_bandwidth_for_server>31457280</max_backup_bandwidth_for_server>
</clickhouse>
